{
	"id": "custom-episode-metadata",
	"name": "Custom Episode Metadata",
	"version": "1.2.0",
	"manifestURI": "https://raw.githubusercontent.com/nnotwen/n-seanime-extensions/master/plugins/Custom%20Episode%20Metadata/custom-episode-metadata.json",
	"language": "typescript",
	"type": "plugin",
	"description": "Customize episode metadata of anime in your AniList collection.",
	"author": "nnotwen",
	"icon": "https://raw.githubusercontent.com/nnotwen/n-seanime-extensions/master/plugins/Custom%20Episode%20Metadata/icon.png",
	"website": "https://github.com/nnotwen/n-seanime-extensions",
	"lang": "en",
	"payloadURI": "https://raw.githubusercontent.com/nnotwen/n-seanime-extensions/master/plugins/Custom%20Episode%20Metadata/provider.ts",
	"plugin": {
		"version": "1",
		"permissions": {
			"scopes": ["storage"],
			"allow": {
				"networkAccess": {
					"allowedDomains": ["api.themoviedb.org", "animeapi.my.id"],
					"reasoning": "Used for accessing the tmdb API"
				}
			}
		}
	},
	"userConfig": {
		"requiresConfig": false,
		"version": 1,
		"fields": [
			{
				"name": "tmdb-api",
				"label": "TMDB API KEY",
				"type": "text",
				"default": ""
			},
			{
				"name": "image-size",
				"label": "TMDB Image Sizes",
				"type": "select",
				"default": "w300",
				"options": [
					{
						"label": "92 Pixels wide",
						"value": "w92"
					},
					{
						"label": "185 Pixels wide",
						"value": "w185"
					},
					{
						"label": "300 Pixels wide",
						"value": "w300"
					},
					{
						"label": "Original",
						"value": "original"
					}
				]
			}
		]
	}
}
